---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { certificates } from '../../data/certificates';

const base = import.meta.env.BASE_URL;

const allPosts = await getCollection('siberGuvenlik', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formatter = new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout
	title="Siber Güvenlik — Ali Ayyıldız"
	description="CTF çözümleri, güvenlik notları ve üzerinde çalıştığım konular."
>
	<main class="wrap section">
		<p class="mono eyebrow"><span class="hash">#</span> siber-guvenlik</p>
		<h1>Siber Güvenlik</h1>
		<p class="intro">CTF çözümlerim, güvenlik notlarım ve üzerinde çalıştığım konular.</p>

		<h2 class="subhead mono"><span class="hash">//</span> sertifikalar</h2>
		<ul class="cert-grid">
			{
				certificates.map((cert) => (
					<li class="cert">
						<p class="cert-title">{cert.title}</p>
						<p class="cert-meta mono">
							{cert.issuer} · {cert.date}
						</p>
						{cert.credentialId && <p class="cert-id mono">{cert.credentialId}</p>}
					</li>
				))
			}
		</ul>

		<h2 class="subhead mono"><span class="hash">//</span> yazılar</h2>
		{
			posts.length === 0 ? (
				<p class="empty mono">Henüz bir yazı eklenmedi — yakında burada olacak.</p>
			) : (
				<ul class="post-list">
					{posts.map((post) => (
						<li>
							<a class="post-card" href={`${base}siber-guvenlik/${post.id}/`}>
								<p class="date mono">{formatter.format(post.data.date)}</p>
								<h3>{post.data.title}</h3>
								<p class="summary">{post.data.summary}</p>
								{post.data.tags.length > 0 && (
									<ul class="tags mono">
										{post.data.tags.map((tag) => (
											<li>{tag}</li>
										))}
									</ul>
								)}
							</a>
						</li>
					))}
				</ul>
			)
		}
	</main>
</Layout>

<style>
	.eyebrow {
		font-size: 0.85rem;
		color: var(--accent-cyber);
		margin-bottom: 0.75rem;
	}

	.hash {
		color: var(--accent-cyber);
	}

	.intro {
		color: var(--text-dim);
		max-width: 38rem;
		margin-bottom: 2.5rem;
	}

	.subhead {
		font-size: 0.8rem;
		color: var(--text-dim);
		letter-spacing: 0.02em;
		margin-bottom: 1.25rem;
	}

	.subhead .hash {
		color: var(--accent-cyber);
	}

	.cert-grid {
		list-style: none;
		margin: 0 0 3rem;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
		gap: 0.85rem;
	}

	.cert {
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 0.9rem 1.1rem;
		background: var(--bg-panel);
	}

	.cert-title {
		font-size: 0.9rem;
		margin: 0 0 0.35rem;
		color: var(--text);
	}

	.cert-meta {
		font-size: 0.72rem;
		color: var(--accent-cyber);
		margin: 0;
	}

	.cert-id {
		font-size: 0.68rem;
		color: var(--text-faint);
		margin: 0.3rem 0 0;
	}

	.empty {
		color: var(--text-faint);
		font-size: 0.9rem;
		padding: 2rem 0;
	}

	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1.25rem;
	}

	.post-card {
		display: block;
		text-decoration: none;
		background: var(--bg-panel);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.5rem 1.75rem;
		transition: border-color 0.15s ease;
	}

	.post-card:hover {
		border-color: var(--accent-cyber);
	}

	.date {
		font-size: 0.72rem;
		color: var(--accent-cyber);
		margin-bottom: 0.5rem;
	}

	.post-card h3 {
		font-size: 1.15rem;
		margin-bottom: 0.5rem;
	}

	.summary {
		color: var(--text-dim);
		font-size: 0.95rem;
		margin: 0 0 0.75rem;
	}

	.tags {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
	}

	.tags li {
		font-size: 0.7rem;
		color: var(--text-dim);
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 0.18rem 0.6rem;
	}
</style>
