---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const path = Astro.url.pathname.replace(base, '/').replace(/\/+/g, '/');

const links = [
	{ href: '/', label: 'ana-sayfa' },
	{ href: '/projeler/', label: 'projeler' },
	{ href: '/siber-guvenlik/', label: 'siber-guvenlik' },
	{ href: '/tefekkur/', label: 'tefekkur' },
	{ href: '/iletisim/', label: 'iletisim' },
];

function isActive(href: string) {
	if (href === '/') return path === '/';
	return path.startsWith(href);
}
---

<header class="site-header">
	<div class="wrap bar">
		<a class="brand mono" href={`${base}`}>
			<span class="prompt">ali@ayyildiz</span><span class="dim">:~$</span>
		</a>
		<nav class="mono" aria-label="Ana gezinme">
			{
				links.map((link) => (
					<a
						href={`${base}${link.href.replace(/^\//, '')}`}
						class:list={['nav-link', { active: isActive(link.href) }]}
					>
						~/{link.label}
					</a>
				))
			}
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: rgba(13, 14, 16, 0.82);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--border-soft);
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
		padding-top: 1.1rem;
		padding-bottom: 1.1rem;
		max-width: 58rem;
	}

	.brand {
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--text);
		white-space: nowrap;
	}

	.brand .prompt {
		color: var(--accent-strong);
	}

	.brand .dim {
		color: var(--text-faint);
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 1.15rem;
		font-size: 0.85rem;
	}

	.nav-link {
		text-decoration: none;
		color: var(--text-dim);
		padding: 0.2rem 0;
		border-bottom: 1px solid transparent;
		transition:
			color 0.15s ease,
			border-color 0.15s ease;
	}

	.nav-link:hover {
		color: var(--text);
	}

	.nav-link.active {
		color: var(--accent-strong);
		border-bottom-color: var(--accent-border);
	}
</style>
